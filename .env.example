# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ─── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (required for the agent) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: route through an Anthropic-compatible proxy instead of api.anthropic.com.
# Everything the agent sees (commands, leads, your profile) then passes through that provider.
# e.g. https://api.mwapi.dev (a trailing /v1 is fine). Set AGENT_MODEL to a model the proxy serves.
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max. medium keeps WhatsApp replies quick; raise for deeper research.
AGENT_EFFORT=medium
# 1 = use only the basic Messages API (no betas, thinking, effort or server tools). Set it for proxies
# that reject those; the agent also switches to it on its own after the first such rejection.
AGENT_COMPAT=

# ─── WhatsApp agent (WhatsApp → Settings → Agents) ───────────────────────────
# Off by default. With true, `npm run dev` / `npm start` run a background worker
# that answers the agent chat; on Vercel, schedule /api/whatsapp-agent/poll (see README).
WHATSAPP_AGENT_ENABLED=false
# The agent's key. Leave empty to paste it in Settings → WhatsApp agent instead (stored encrypted).
WHATSAPP_AGENT_KEY=
# Workspace the key above belongs to. Only needed when there is more than one workspace.
WHATSAPP_AGENT_WORKSPACE_ID=

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=          # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=            # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=          # any random string; paste the same into Meta's webhook setup
WHATSAPP_BUSINESS_NUMBER=       # e.g. 15125550100, shown to users when linking
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_OUTREACH_TEMPLATE=     # approved template for first-touch messages to opted-in leads, body: {{1}} name, {{2}} message
WHATSAPP_NOTIFY_TEMPLATE=       # approved utility template for owner alerts, body: {{1}} alert text
WHATSAPP_TEMPLATE_LANG=en_US

# ─── Lead research (all optional; the agent uses whatever is configured) ────
SERPAPI_API_KEY=                # Google + Google Maps search (recommended)
GOOGLE_CSE_API_KEY=             # fallback web search
GOOGLE_CSE_ID=
APOLLO_API_KEY=                 # decision makers + company enrichment
HUNTER_API_KEY=                 # email finder
CLEARBIT_API_KEY=               # legacy keys only; Clearbit no longer sells standalone API access

# ─── Email sending (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Sales <sales@yourdomain.com>"    # must be on a Resend-verified domain
COMPANY_POSTAL_ADDRESS="Acme Inc, 123 Main St, Austin, TX 78701, USA"   # required in commercial email (CAN-SPAM)
UNSUBSCRIBE_SECRET=             # openssl rand -hex 32

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET=                    # openssl rand -hex 32; Vercel sends it as a Bearer token. Also for scheduling /api/whatsapp-agent/poll
